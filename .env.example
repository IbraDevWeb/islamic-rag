APP_NAME=Islamic RAG API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=islamic_rag
POSTGRES_USER=islamic_rag
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

QDRANT_URL=http://qdrant:6333
QDRANT_DENSE_COLLECTION=islamic_rag_dense_e5_v1

EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CACHE_DIR=/root/.cache/fastembed

RERANKER_CANDIDATE_POOL=20
RERANKER_BATCH_SIZE=4
RERANKER_THREADS=4
RERANKER_CACHE_DIR=/root/.cache/fastembed

# Generated synthesis is opt-in. Keep disabled until a local provider is ready.
SYNTHESIS_PROVIDER=disabled
SYNTHESIS_OLLAMA_URL=http://host.docker.internal:11434
SYNTHESIS_MODEL=qwen3:8b
# Development default reuses the generator. A different verifier model is preferable
# for later independent evaluation, but no verifier result is treated as scholarly review.
SYNTHESIS_VERIFIER_MODEL=qwen3:8b
SYNTHESIS_TIMEOUT_SECONDS=180
SYNTHESIS_TEMPERATURE=0
